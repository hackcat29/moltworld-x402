# Moltworld Configuration Environment Variables

# Network Selection: "testnet" or "mainnet" (defaults to testnet)
ALGORAND_NETWORK=testnet

# Algorand PayTo Address (Merchant Address receiving USDC)
# Required for mainnet. A default funded/valid testnet address is provided if omitted.
AVM_ADDRESS=XFYEO7VOP3KX2YHZLQBQLM6L565IQJWYZGNG36OF44GYW5FF2FQXURFR7Q

# GoPlausible x402 Facilitator Endpoint
FACILITATOR_URL=https://facilitator.goplausible.xyz

# Public Root Domain
PUBLIC_DOMAIN=https://moltworld.xyz

# Server Listening Port
PORT=3402

# ==============================================================================
# Upstream AI Provider Keys (Fail-Closed: Only enabled when valid key provided)
# ==============================================================================
OPENROUTER_API_KEY=
FAL_KEY=
OPENAI_API_KEY=
ELEVENLABS_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_AI_API_KEY=
DEEPSEEK_API_KEY=

# Mock Provider Mode: Set to "true" during testing to mock upstream responses
MOCK_PROVIDERS=false

# ==============================================================================
# Pricing & Margin Configuration (Pure Cost-Plus)
# ==============================================================================
PRICE_MARGIN=0.30
PRICE_MIN_FLOOR=0.0010

# ==============================================================================
# Persistence & Distributed State (Postgres 16 & Redis 7 via Docker Compose)
# ==============================================================================
# Defaults point to local docker-compose services
DATABASE_URL=postgres://moltworld:moltworld_secure_password@127.0.0.1:5432/moltworld
REDIS_URL=redis://:moltworld_redis_password@127.0.0.1:6379

# ==============================================================================
# Cryptographic Verifiable Receipts (Ed25519)
# ==============================================================================
# Base64-encoded 32-byte Ed25519 private seed. If omitted, gateway generates a deterministic persistent seed.
RECEIPT_SIGNING_KEY=

# ==============================================================================
# Automated Upfront Refund Hot Wallet
# ==============================================================================
# 25-word Algorand mnemonic for the hot refund wallet (funded with ~20 USDC + 1 ALGO)
# Used to execute instant on-chain refunds if upstream generation fails
REFUND_MNEMONIC=
