# ------------------------------------------------------------------------------
# Network and payments
# ------------------------------------------------------------------------------
# "testnet" or "mainnet"
ALGORAND_NETWORK=testnet
# Revenue address that receives every x402 payment. The gateway never needs its
# key, so use a cold or multisig account on mainnet. Required on mainnet.
AVM_ADDRESS=
FACILITATOR_URL=https://facilitator.goplausible.xyz
PUBLIC_DOMAIN=https://moltworld.xyz
DOCS_URL=https://docs.moltworld.xyz
PORT=3402
# Algod used for balance checks, mandate expiry and payouts (defaults to algonode).
ALGOD_URL=
ALGOD_TOKEN=

# Hot wallet that sends refunds, usage rebates and creator payouts (25-word
# mnemonic). Keep only a working float of USDC + a little ALGO in it. Without it,
# refunds and payouts stay pending in the ledger (see /v1/ops/*).
PAYOUT_WALLET_MNEMONIC=

# ------------------------------------------------------------------------------
# Upstream providers. A model is sold only if its provider key is set AND its
# upstream id is verified at startup.
# ------------------------------------------------------------------------------
OPENROUTER_API_KEY=
FAL_KEY=
OPENAI_API_KEY=
ELEVENLABS_API_KEY=

# ------------------------------------------------------------------------------
# Pricing: price = max(PRICE_MIN_FLOOR, upstream cost x (1 + PRICE_MARGIN))
# Per-model cost overrides: COST_<SLUG>=in,out (USD per 1M tokens) for chat,
# or the per-unit USD rate for image/voice/video, e.g. COST_FLUX_2_PRO=0.06
# ------------------------------------------------------------------------------
PRICE_MARGIN=0.30
PRICE_MIN_FLOOR=0.001
REBATE_MIN_PAYOUT_USD=0.05
CREATOR_PAYOUT_MIN_USD=1
MARKETPLACE_FEE_PERCENT=15
# Unsettled chat requests one wallet may have in flight.
MAX_INFLIGHT_PER_PAYER=4

# ------------------------------------------------------------------------------
# State. DATABASE_URL is required on mainnet; without it the gateway uses an
# in-process PGlite database (development only). Redis is optional for a single
# process and required when running several.
# ------------------------------------------------------------------------------
POSTGRES_PASSWORD=
REDIS_PASSWORD=
DATABASE_URL=
REDIS_URL=

# ------------------------------------------------------------------------------
# Receipts: base64 32-byte Ed25519 seed (`openssl rand -base64 32`). Required on
# mainnet. When rotating, list old public keys so old receipts stay verifiable.
# ------------------------------------------------------------------------------
RECEIPT_SIGNING_KEY=
RECEIPT_PREVIOUS_PUBLIC_KEYS=

# ------------------------------------------------------------------------------
# Operations
# ------------------------------------------------------------------------------
# Bearer token for /v1/ops/* (refund queue, payouts, listing review). Unset = disabled.
ADMIN_TOKEN=
# Wallets whose traffic is excluded from /v1/stats (comma-separated).
OPERATOR_WALLETS=
MOCK_PROVIDERS=false
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW_MS=60000
