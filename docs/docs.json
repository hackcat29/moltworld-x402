{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Moltworld",
  "description": "AI models for apps and agents, paid per request in USDC on Algorand through x402.",
  "colors": {
    "primary": "#00875F",
    "light": "#00E5A3",
    "dark": "#00875F"
  },
  "logo": {
    "light": "/logo/logo.png",
    "dark": "/logo/logo.png",
    "href": "https://moltworld.xyz"
  },
  "favicon": "/favicon.png",
  "appearance": {
    "default": "dark"
  },
  "navbar": {
    "links": [
      { "label": "Models", "href": "https://moltworld.xyz/models" },
      { "label": "GitHub", "href": "https://github.com/hackcat29/moltworld-x402" }
    ],
    "primary": {
      "type": "button",
      "label": "Playground",
      "href": "https://moltworld.xyz/playground"
    }
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Guides",
        "groups": [
          {
            "group": "Get started",
            "pages": ["index", "quickstart"]
          },
          {
            "group": "Concepts",
            "pages": [
              "concepts/how-payment-works",
              "concepts/pricing",
              "concepts/refunds-and-rebates",
              "concepts/receipts",
              "concepts/models"
            ]
          },
          {
            "group": "Products",
            "pages": ["products/mandates", "products/marketplace"]
          },
          {
            "group": "Guides",
            "pages": ["guides/video-jobs", "guides/verify-receipts", "guides/handle-errors"]
          }
        ]
      },
      {
        "tab": "Agents",
        "groups": [
          {
            "group": "Connect an agent",
            "pages": ["agents/mcp", "agents/openclaw", "agents/hermes", "agents/claude-code", "agents/a2a"]
          }
        ]
      },
      {
        "tab": "SDKs",
        "groups": [
          {
            "group": "Client libraries",
            "pages": ["sdks/typescript", "sdks/python", "sdks/http"]
          }
        ]
      },
      {
        "tab": "API reference",
        "groups": [
          {
            "group": "Overview",
            "pages": ["api-reference/introduction", "api-reference/errors"]
          },
          {
            "group": "Models",
            "pages": [
              "api-reference/endpoints/chat",
              "api-reference/endpoints/images",
              "api-reference/endpoints/speech",
              "api-reference/endpoints/videos"
            ]
          },
          {
            "group": "Pricing and catalog",
            "pages": ["api-reference/endpoints/quote", "api-reference/endpoints/list-models"]
          },
          {
            "group": "Jobs and receipts",
            "pages": [
              "api-reference/endpoints/get-job",
              "api-reference/endpoints/get-receipt",
              "api-reference/endpoints/receipt-keys"
            ]
          },
          {
            "group": "Mandates",
            "pages": [
              "api-reference/endpoints/draft-mandate",
              "api-reference/endpoints/register-mandate",
              "api-reference/endpoints/get-mandate",
              "api-reference/endpoints/list-mandates",
              "api-reference/endpoints/revoke-mandate"
            ]
          },
          {
            "group": "Marketplace",
            "pages": [
              "api-reference/endpoints/list-listings",
              "api-reference/endpoints/create-listing",
              "api-reference/endpoints/call-listing",
              "api-reference/endpoints/creator-earnings"
            ]
          },
          {
            "group": "Service",
            "pages": ["api-reference/endpoints/health", "api-reference/endpoints/stats"]
          }
        ]
      }
    ]
  },
  "api": {
    "openapi": "api-reference/openapi.json",
    "playground": {
      "display": "simple"
    }
  },
  "footer": {
    "socials": {
      "github": "https://github.com/hackcat29/moltworld-x402",
      "website": "https://moltworld.xyz"
    }
  },
  "seo": {
    "indexing": "navigable"
  }
}
