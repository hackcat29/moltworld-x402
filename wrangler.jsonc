{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Pass-through only: all application logic runs on the VPS origin (see src/worker.ts).
  "name": "moltworld-x402",
  "main": "src/worker.ts",
  "compatibility_date": "2026-03-01",
  "routes": [
    { "pattern": "moltworld.xyz/*", "zone_name": "moltworld.xyz" },
    { "pattern": "www.moltworld.xyz/*", "zone_name": "moltworld.xyz" }
  ]
}
